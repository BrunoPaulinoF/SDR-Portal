{
  "name": "sdr-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:create": "node dist/src/db/create-admin.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/src/db/migrate.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/src/server.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "pg-boss": "^10.1.6",
    "postgres": "^3.4.5",
    "read-excel-file": "^9.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.4",
    "write-excel-file": "^4.0.6"
  }
}
